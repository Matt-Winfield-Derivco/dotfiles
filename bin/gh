#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
self_path="$script_dir/gh"

GH_ORG_TOKEN_MAP=(
  "Sports-Global:SPORTS_GLOBAL_GITHUB_TOKEN"
  "sg-ltd:SUPERGROUP_GITHUB_TOKEN"
)

resolve_gh_binary() {
  local candidate
  while IFS= read -r candidate; do
    if [[ -n "$candidate" && "$candidate" != "$self_path" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(which -a gh 2>/dev/null || true)

  return 1
}

resolve_remote_url() {
  local remote remote_url
  for remote in origin upstream; do
    remote_url="$(git remote get-url "$remote" 2>/dev/null || true)"
    if [[ -n "$remote_url" ]]; then
      printf '%s\n' "$remote_url"
      return 0
    fi
  done

  return 1
}

gh_token_for_env_var() {
  local token_var_name="${1:-}"
  "$script_dir/github-access-token" "$token_var_name" 2>/dev/null
}

main() {
  local gh_bin remote_url mapping org token_var token
  gh_bin="$(resolve_gh_binary)"

  remote_url="$(resolve_remote_url || true)"
  if [[ -n "$remote_url" ]]; then
    for mapping in "${GH_ORG_TOKEN_MAP[@]}"; do
      org="${mapping%%:*}"
      token_var="${mapping#*:}"
      if [[ "$remote_url" == *"github.com"*"/$org/"* || "$remote_url" == *"github.com"*":$org/"* ]]; then
        if token="$(gh_token_for_env_var "$token_var")"; then
          GH_TOKEN="$token" GITHUB_TOKEN="$token" exec "$gh_bin" "$@"
        fi
      fi
    done
  fi

  exec "$gh_bin" "$@"
}

main "$@"
